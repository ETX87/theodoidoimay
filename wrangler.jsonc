{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thuky-mail",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // D1 rieng cua thuky-mail (tach khoi DVBH de khong lam nang dvbh-db-smarttrade).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "thuky-mail-db",
      "database_id": "8884a9d9-e098-46da-8e40-7d8a4969a592",
      "migrations_dir": "migrations"
    }
  ]
  // Secrets (wrangler secret put): APP_PASSWORD (dang nhap web), INGEST_KEY (Apps Script gui mail len).
}
